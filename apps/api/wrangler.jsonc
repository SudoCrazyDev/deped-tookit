{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "depedtoolkit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "depedtoolkit",
      "database_id": "a10dde31-ac36-468e-8a37-9f9d853e7a01",
      "migrations_dir": "migrations"
    }
  ],

  // Uploaded class pictures / imported Excel files land here.
  // Uncomment once created: wrangler r2 bucket create depedtoolkit-uploads
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "depedtoolkit-uploads" }],

  "vars": {
    "APP_ORIGIN": "http://localhost:5174"
  }
  // Secrets (set with `wrangler secret put`):
  //   SESSION_SECRET — HMAC key for signing session cookies
}
