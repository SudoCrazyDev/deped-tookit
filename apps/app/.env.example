# Leave blank in dev so requests go through the Vite proxy to localhost:8787.
# In production point this at the deployed API worker.
VITE_API_URL=

# Cloudflare Turnstile sitekey. Public by design — it ships in the page source.
# Left blank, the app falls back to Cloudflare's always-passes test sitekey.
VITE_TURNSTILE_SITE_KEY=
